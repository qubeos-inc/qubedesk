+//! qubeDesk: что наш сервер делает сверх открытой версии.
+//!
+//! 1. Обмен ключами на TCP — тот, что программа ждёт после входа через qubeOS:
+//!    сервер первым шлёт свой временный ключ, подписанный ключом сервера,
+//!    программа отвечает симметричным ключом, запечатанным для него. Дальше
+//!    канал шифруется (схема «версия 0»: один ключ, счётчики в нонсе).
+//! 2. Проверка прав: пропуск (токен) из запроса на подключение уходит в qubeOS,
+//!    и та говорит, можно ли этому человеку к этому компьютеру.
+use hbb_common::{
+    bytes::{Bytes, BytesMut},
+    bytes_codec::BytesCodec,
+    futures_util::{SinkExt, StreamExt},
+    log,
+    protobuf::Message as _,
+    rendezvous_proto::*,
+    tcp::Encrypt,
+    timeout,
+    tokio::net::TcpStream,
+    tokio_util::codec::Framed,
+    ResultType,
+};
+use once_cell::sync::Lazy;
+use sodiumoxide::crypto::{box_, sign};
+use std::{
+    collections::HashMap,
+    sync::{Arc, Mutex},
+    time::{Duration, Instant},
+};
+
+pub type SharedEncrypt = Arc<Mutex<Encrypt>>;
+
+/// Чем закончилось начало разговора с программой.
+pub enum Kx {
+    /// Программа прислала ключ — канал дальше зашифрован.
+    Secured(SharedEncrypt),
+    /// Программа сразу заговорила открыто (старые версии, без входа) — это её первое сообщение.
+    Plain(BytesMut),
+    /// Ничего не прислала.
+    Closed,
+}
+
+pub async fn server_kx(framed: &mut Framed<TcpStream, BytesCodec>, sk: &sign::SecretKey) -> ResultType<Kx> {
+    let (our_pk, our_sk) = box_::gen_keypair();
+    let mut msg = RendezvousMessage::new();
+    msg.set_key_exchange(KeyExchange {
+        keys: vec![sign::sign(&our_pk.0, sk).into()],
+        ..Default::default()
+    });
+    framed.send(Bytes::from(msg.write_to_bytes()?)).await?;
+    let bytes = match timeout(30_000, framed.next()).await {
+        Ok(Some(Ok(b))) => b,
+        _ => return Ok(Kx::Closed),
+    };
+    if let Ok(m) = RendezvousMessage::parse_from_bytes(&bytes) {
+        if let Some(rendezvous_message::Union::KeyExchange(ex)) = m.union {
+            if ex.keys.len() != 2 {
+                hbb_common::bail!("неверный ответ на обмен ключами");
+            }
+            let key = Encrypt::decode(&ex.keys[1], &ex.keys[0], &our_sk)?;
+            return Ok(Kx::Secured(Arc::new(Mutex::new(Encrypt::new(key)))));
+        }
+    }
+    Ok(Kx::Plain(bytes))
+}
+
+// ── Проверка прав в qubeOS ─────────────────────────────────────────────
+
+static HTTP: Lazy<reqwest::Client> = Lazy::new(|| {
+    reqwest::Client::builder()
+        .timeout(Duration::from_secs(3))
+        .build()
+        .unwrap_or_default()
+});
+
+/// Решения помним минуту: один заход программы — это несколько запросов подряд.
+static CACHE: Lazy<Mutex<HashMap<(String, String), (Instant, Option<String>)>>> =
+    Lazy::new(Default::default);
+
+/// `None` — пускаем, `Some(причина)` — нет. Если qubeOS не ответила, пускаем:
+/// пароль на том компьютере всё равно спросят, а помощь не должна вставать.
+pub async fn access(token: &str, id: &str, ip: &str) -> Option<String> {
+    if token.is_empty() {
+        return None;
+    }
+    let (Ok(url), Ok(secret)) = (std::env::var("QUBEDESK_ACCESS_URL"), std::env::var("QUBEDESK_SECRET")) else {
+        return None;
+    };
+    let k = (token.to_owned(), id.to_owned());
+    if let Some((at, r)) = CACHE.lock().unwrap().get(&k) {
+        if at.elapsed() < Duration::from_secs(60) {
+            return r.clone();
+        }
+    }
+    let body = serde_json::json!({ "token": token, "id": id, "ip": ip });
+    let r = match HTTP.post(&url).header("x-qd-secret", secret).json(&body).send().await {
+        Ok(res) if res.status().is_success() => match res.json::<serde_json::Value>().await {
+            Ok(v) if v["allow"].as_bool() == Some(false) => Some(
+                v["reason"].as_str().unwrap_or("Нет доступа к этому компьютеру").to_owned(),
+            ),
+            _ => None,
+        },
+        Ok(res) => {
+            log::warn!("qubeOS ответила {} на проверку доступа", res.status());
+            None
+        }
+        Err(e) => {
+            log::warn!("qubeOS не ответила на проверку доступа: {e}");
+            None
+        }
+    };
+    let mut c = CACHE.lock().unwrap();
+    if c.len() > 5000 {
+        c.clear();
+    }
+    c.insert(k, (Instant::now(), r.clone()));
+    r
+}
